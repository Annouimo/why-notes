{
  "name": "why-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "WHY_NOTES_PREVIEW=1 astro dev --ignore-lock",
    "build": "astro build",
    "build:preview": "WHY_NOTES_PREVIEW=1 astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check && node --test tests/*.test.ts",
    "new:note": "node scripts/new-note.mjs",
    "pack:preview": "npm run build:preview && node scripts/pack-preview.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/mdx": "^8.1.5",
    "astro": "^7.4.11",
    "katex": "0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
